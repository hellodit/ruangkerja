# --- App ---------------------------------------------------------------
# Public base URL of the app (used for auth callbacks and email links)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---------------------------------------------
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruangkerja

# --- Better Auth -------------------------------------------------------
# Generate with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=

# --- Google OAuth ------------------------------------------------------
# Authorized redirect URI: {NUXT_PUBLIC_SITE_URL}/api/auth/callback/google
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ----------------------------------------------------
NUXT_RESEND_API_KEY=
# Must use a domain verified in Resend
NUXT_EMAIL_FROM="Ruang Kerja <no-reply@example.com>"

# --- Cloudflare Turnstile ----------------------------------------------
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 -----------------------------------------------------
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
# Bucket with public access enabled (avatars)
NUXT_R2_PUBLIC_BUCKET=ruangkerja-public
# Bucket without public access (documents)
NUXT_R2_PRIVATE_BUCKET=ruangkerja-private
# Public base URL of the public bucket (custom domain or r2.dev), no trailing slash
NUXT_R2_PUBLIC_URL=https://assets.example.com

# --- SingaPay ----------------------------------------------------------
# HMAC Validation Key from the SingaPay dashboard (comma-separate to rotate)
NUXT_SINGAPAY_WEBHOOK_SECRET=
