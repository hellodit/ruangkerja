# --- App ---------------------------------------------------------------
# Public base URL of the app (used for auth callbacks and email links)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact shown on /privasi (optional)
NUXT_PUBLIC_SUPPORT_EMAIL=

# Set to true only behind ONE trusted reverse proxy that sets X-Forwarded-For
# (Vercel, nginx). Used to resolve the client IP for auth rate limiting.
NUXT_TRUST_PROXY=false

# --- Database (PostgreSQL) ---------------------------------------------
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruangkerja

# --- Better Auth -------------------------------------------------------
# Generate with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=

# --- Google OAuth ------------------------------------------------------
# Authorized redirect URI: {NUXT_PUBLIC_SITE_URL}/api/auth/callback/google
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ----------------------------------------------------
NUXT_RESEND_API_KEY=
# Must use a domain verified in Resend
NUXT_EMAIL_FROM="Ruang Kerja <no-reply@example.com>"

# --- Cloudflare Turnstile ----------------------------------------------
# Production: keys from the Cloudflare dashboard (Turnstile > your widget).
# Local dev: use Cloudflare's test keys below. The widget passes on its own and
# the server accepts its dummy token. Never use them in production: every
# request would pass, so login and sign-up lose their bot protection.
#   NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 -----------------------------------------------------
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
# Bucket with public access enabled (profile photos only)
NUXT_R2_PUBLIC_BUCKET=ruangkerja-avatars
# Public base URL of the public bucket (custom domain or r2.dev), no trailing slash
NUXT_R2_PUBLIC_URL=https://assets.example.com

# --- SumoPay (Managed Payment) ---------------------------------------
# API key from Managed Payment → Quick Start. Empty = manual bank transfer.
NUXT_SUMOPAY_API_KEY=
# Live: https://api-pay.sumopod.com · Sandbox: https://api-pay-sandbox.sumopod.com
NUXT_SUMOPAY_BASE_URL=https://api-pay.sumopod.com
# Signing Secret (whsec_...) from Settings → Webhook (comma-separate to rotate)
NUXT_SUMOPAY_WEBHOOK_SECRET=
# Optional payment method code, e.g. QRIS (empty = customer chooses)
NUXT_SUMOPAY_PAYMENT_METHOD=

# Manual bank transfer for package payments (shown on /subscription)
NUXT_PUBLIC_PAYMENT_BANK_NAME=
NUXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=
NUXT_PUBLIC_PAYMENT_ACCOUNT_NAME=
# WhatsApp for payment confirmation, international format without '+', e.g. 6281234567890
NUXT_PUBLIC_PAYMENT_WHATSAPP=
